{
  "name": "gardening-etl",
  "version": "1.0.0",
  "description": "ETL pipeline for scraping plant companion data via BullMQ into SQLite and Neo4j",
  "main": "dist/pipeline.js",
  "scripts": {
    "build": "tsc",
    "pipeline": "tsx src/pipeline.ts",
    "scrape": "tsx src/scrapers/run.ts",
    "monitor": "tsx src/monitor.ts",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "author": "R. Bryce Bond",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^6.20.6",
    "@bull-board/express": "^6.20.6",
    "bullmq": "^5.71.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "neo4j-driver": "^6.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
